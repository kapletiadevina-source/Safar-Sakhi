# ==============================================================================
# Safar Sakhi - Root .gitignore
# ==============================================================================

# 1. Environment & Secret Credentials (CRITICAL - NEVER COMMIT)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# 2. Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# 3. Production Build Artifacts
dist/
dist-ssr/
build/
backend/dist/
frontend/dist/
*.local

# 4. Logs & Debug Artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Runtime & Cache Data
.pnp
.pnp.js
.cache/
.vite/
.turbo/

# 6. Database & Local Storage Files
*.sqlite
*.sqlite3
*.db
*.db-journal

# 7. OS & Editor Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

