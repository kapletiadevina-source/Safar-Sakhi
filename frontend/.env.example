# Backend API URL
VITE_API_URL=http://localhost:5000/api

# Backend Real-time Socket.IO URL
VITE_SOCKET_URL=http://localhost:5000

# Supabase Authentication & Google OAuth
# Obtain from your Supabase project dashboard (Settings -> API)
# Ensure Site URL is: http://localhost:5173
# Ensure Redirect URL includes: http://localhost:5173/*
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here
