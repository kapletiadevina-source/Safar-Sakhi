# ==========================================
# Safar Sakhi - Backend Environment Template
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/safar_sakhi?schema=public"

# JWT Authentication Secret (Use a strong random secret in production)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google Gemini API Key
# Obtain from https://aistudio.google.com/
# If left empty, Safar Sakhi AI companion uses intelligent built-in safety responses
GEMINI_API_KEY=your_gemini_api_key_here
